# Copie este arquivo para .env e preencha os valores reais.
# O arquivo .env nunca deve ser commitado no git.

# Banco de dados
DATABASE_URL=sqlite:///./crm.db

# Chave secreta para assinar tokens JWT — troque por uma string aleatória longa em produção
# Gerar: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=nexus-crm-dev-secret-change-in-prod

# Credenciais do usuário admin criado na primeira inicialização
ADMIN_EMAIL=admin@nexus.com
ADMIN_PASSWORD=admin123

# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGINS_STR=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1

# Logging: formato "json" (produção/Docker) ou "text" (desenvolvimento)
LOG_FORMAT=json
# Nível: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
